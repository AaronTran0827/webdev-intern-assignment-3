// Prisma Schema Definition for G-Scores THPT 2024 System
// Database Provider: PostgreSQL on Supabase

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  sbd          String   @id @unique
  toan         Float?
  ngu_van      Float?
  ngoai_ngu    Float?
  vat_li       Float?
  hoa_hoc      Float?
  sinh_hoc     Float?
  lich_su      Float?
  dia_li       Float?
  gdcd         Float?
  ma_ngoai_ngu String?
  created_at   DateTime @default(now()) @map("created_at")
  updated_at   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("students")
}
